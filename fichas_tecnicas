<script>
    function setupPreview(inputId, previewId) {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        if (!input || !preview) return;
        input.addEventListener('change', function() {
            preview.innerHTML = '';
            for (const file of this.files) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    preview.appendChild(img);
                };
                reader.readAsDataURL(file);
            }
        });
    }
    setupPreview('imagenesTecnicas', 'previewTecnicas');
    setupPreview('imagenesObra', 'previewObra');
    setupPreview('imagenesTermicas', 'previewTermicas');
    setupPreview('logoInput', 'previewLogo');

    function agregarFilaMaterial() {
        const tbody = document.querySelector('#tablaMateriales tbody');
        if (!tbody) return;
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><input type="text" placeholder="Material" /></td><td><input type="text" placeholder="Referencia" /></td><td><input type="text" placeholder="Conductividad" /></td><td><input type="text" placeholder="Enlace ficha" /></td>`;
        tbody.appendChild(tr);
    }

    function getImagesFromPreview(previewId) {
        const preview = document.getElementById(previewId);
        if (!preview) return [];
        const imgs = preview.querySelectorAll('img');
        const result = [];
        imgs.forEach(img => { if (img.src && img.src.startsWith('data:image')) result.push(img.src); });
        return result;
    }

    // SANITIZAR TEXTOS - FIX PARA LOS SÍMBOLOS ≤ y ≥
    function sanitizeText(text) {
        if (!text) return '';
        return text
            .replace(/\u03BC/g, '\u00B5') 
            .replace(/≤/g, '<=') // SOLUCIONA EL SÍMBOLO ROTO EN EL PDF
            .replace(/≥/g, '>=')
            .replace(/–/g, '-')
            .replace(/—/g, '-')
            .replace(/“/g, '"')
            .replace(/”/g, '"')
            .replace(/‘/g, "'")
            .replace(/’/g, "'")
            .replace(/…/g, '...');
    }

    function getImageDimensions(dataUrl, maxWidth, maxHeight) {
        return new Promise((resolve) => {
            const img = new Image();
            img.onload = function() {
                let w = this.width; let h = this.height;
                const ratio = Math.min(maxWidth / w, maxHeight / h, 1);
                w = w * ratio; h = h * ratio;
                resolve({ width: w, height: h });
            };
            img.onerror = () => resolve({ width: maxWidth, height: maxHeight });
            img.src = dataUrl;
        });
    }

    async function generarPDF() {
        if (typeof window.jspdf === 'undefined') {
            alert('La librería jsPDF no se ha cargado.');
            return;
        }

        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF('p', 'mm', 'a4');
        const pageW = 210; const pageH = 297;
        const margin = 18; const maxW = pageW - 2 * margin;
        let y = margin;

        const nombre = document.getElementById('nombreProducto').value || 'Producto sin nombre';
        const referencia = document.getElementById('referencia').value || 'Sin ref.';
        const descripcion = document.getElementById('descripcion').value || '';
        const analisisTabla = document.getElementById('tablaTermica').value || '';
        const resultadoTermico = document.getElementById('resultadoTermico').value || '';
        const fijacion = document.getElementById('fijacionLimites').value || '';
        const recomendaciones = document.getElementById('recomendaciones').value || '';

        const tecnicas = getImagesFromPreview('previewTecnicas');
        const obra = getImagesFromPreview('previewObra');
        const termicas = getImagesFromPreview('previewTermicas');
        const logoData = getImagesFromPreview('previewLogo');

        const filas = document.querySelectorAll('#tablaMateriales tbody tr');
        const materiales = [];
        filas.forEach(tr => {
            const inputs = tr.querySelectorAll('input');
            if (inputs.length >= 4) {
                materiales.push({
                    material: inputs[0].value || '-', referencia: inputs[1].value || '-',
                    conductividad: inputs[2].value || '-', ficha: inputs[3].value || '-'
                });
            }
        });

        function newPage() { pdf.addPage(); y = margin; }

        // =========================================================================
        // FUNCIÓN DINÁMICA PARA MAXIMIZAR IMÁGENES (NUEVA IMPLEMENTACIÓN)
        // =========================================================================
        async function renderDynamicImages(imagesArray) {
            for (let idx = 0; idx < imagesArray.length; idx++) {
                const dimRaw = await new Promise(res => {
                    const img = new Image();
                    img.onload = () => res({w: img.width, h: img.height});
                    img.onerror = () => res({w: maxW, h: maxW}); 
                    img.src = imagesArray[idx];
                });

                const ratio = dimRaw.w / dimRaw.h;
                let availableW = maxW;
                let availableH = pageH - y - margin;

                let scaledW = availableW;
                let scaledH = scaledW / ratio;

                // Si la altura máxima excede el espacio de la página, encogerla para que quepa
                if (scaledH > availableH) {
                    scaledH = availableH;
                    scaledW = scaledH * ratio;
                }

                // Si el espacio restante es muy poco (hace que la imagen mida menos de 65mm de alto)
                // Y NO estamos ya al inicio de la página, saltamos de página para que sea ENORME
                if (scaledH < 65 && y > margin + 40) {
                    newPage();
                    availableH = pageH - y - margin;
                    scaledW = availableW;
                    scaledH = scaledW / ratio;
                    if (scaledH > availableH) {
                        scaledH = availableH;
                        scaledW = scaledH * ratio;
                    }
                }

                // Centramos horizontalmente de forma perfecta
                const x = margin + (maxW - scaledW) / 2;
                pdf.addImage(imagesArray[idx], 'JPEG', x, y, scaledW, scaledH);
                y += scaledH + 10;
            }
        }

        pdf.setFont('helvetica');

        /* PÁGINA 1: PORTADA */
        pdf.setFillColor(62, 62, 62);
        pdf.rect(0, 0, pageW, 38, 'F');

        if (logoData.length > 0) {
            try {
                const dim = await getImageDimensions(logoData[0], 40, 30);
                pdf.addImage(logoData[0], 'JPEG', margin + (40 - dim.width)/2, 6 + (30 - dim.height)/2, dim.width, dim.height);
            } catch (e) {}
        }

        pdf.setTextColor(255, 255, 255); pdf.setFontSize(22);
        pdf.text('FICHA TÉCNICA', pageW - margin, 28, { align: 'right' });

        pdf.setTextColor(30, 43, 58); pdf.setFontSize(26);
        const titleLines = pdf.splitTextToSize(sanitizeText(nombre), maxW);
        pdf.text(titleLines, margin, 70);
